{
  "name": "nerdo-ux",
  "version": "1.1.3",
  "description": "Nerdo UX - Home Assistant Lovelace cards collection",
  "main": "dist/hacs-nerdo-ux.js",
  "type": "module",
  "scripts": {
    "build": "bun scripts/generate-build-info.js && bun build src/press-and-hold-button-card.ts --target browser --format iife --minify --outfile dist/hacs-nerdo-ux.js",
    "dev": "bun scripts/generate-build-info.js && bun build src/press-and-hold-button-card.ts --target browser --format iife --watch --outfile dist/hacs-nerdo-ux.js",
    "lint": "bun scripts/generate-build-info.js && biome check .",
    "typecheck": "bun scripts/generate-build-info.js && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "generate-build-info": "bun scripts/generate-build-info.js",
    "deploy": "bun run build && scp dist/hacs-nerdo-ux.js $HA_HOST:/config/www/",
    "test": "playwright test",
    "format": "biome format . --write",
    "check": "biome check ."
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "card",
    "button",
    "press-hold"
  ],
  "author": "nerdo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerdo/hacs-nerdo-ux.git"
  },
  "homepage": "https://github.com/nerdo/hacs-nerdo-ux",
  "bugs": {
    "url": "https://github.com/nerdo/hacs-nerdo-ux/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "lit": "3.3.3"
  }
}
